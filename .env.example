# Copie este arquivo para `.env.local` e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Nunca exponha a service role key no cliente.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Segredo para criptografar o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=<segredo-com-32-caracteres-ou-mais>

# Chave da OpenAI usada pelo agente Mastra que resume as avaliações (gpt-4o-mini).
OPENAI_API_KEY=<openai-api-key>
